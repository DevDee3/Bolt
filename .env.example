# ──────────────────────────────────────────
#  $BOLT Environment Variables
#  Copy to .env and fill in real values
# ──────────────────────────────────────────

# Deployer private key (without 0x)
PRIVATE_KEY=your_private_key_here

# ── Wallet addresses ──────────────────────
MARKETING_WALLET=0x0000000000000000000000000000000000000000
LIQUIDITY_WALLET=0x0000000000000000000000000000000000000000
RESERVE_WALLET=0x0000000000000000000000000000000000000000

# ── RPC endpoints ─────────────────────────
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org/

# ── PancakeSwap V2 Router ─────────────────
PANCAKE_ROUTER_TESTNET=0xD99D1c33F9fC3444f8101754aBC46c52416550d1
PANCAKE_ROUTER_MAINNET=0x10ED43C718714eb63d5aA57B78B54704E256024E

# Set PANCAKE_ROUTER to whichever network you are deploying to
PANCAKE_ROUTER=0xD99D1c33F9fC3444f8101754aBC46c52416550d1

# ── BSCScan (for verification) ────────────
BSCSCAN_API_KEY=your_bscscan_api_key_here

# ── Set after first deployment ────────────
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
